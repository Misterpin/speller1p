---
config:
  flowchart:
    defaultRenderer: "elk"

---
flowchart TB

    %% ============================================================
    %% Архитектура ЭЭГ-спеллера, v3 (29.09.2026)
    %% Код исходной схемы сохранён; раскладка перестроена из-за новых связей.
    %% Добавлено:
    %%  - фиолетовая пунктирная рамка вокруг Physiology Module = сменный модуль (plug-in);
    %%  - Session Recorder -> Storage, под ним «Таблица данных» (заполняется, см. «Модель данных»);
    %%  - пунктирные стрелки: данные блоков -> Session Recorder -> Storage.
    %% ============================================================

    %% === Main flow (left to right) ===
    PT{{"Primary Text (preceding context)"}}:::data
    FSM["Source Model (Fast LLM)"]:::code
    PT --> FSM

    subgraph SymbDistr ["Symbol Distribution"]
        RSS{{"Repertoire of symbols for selection"}}:::data
        APrD{{"A priori distribution of next symbol"}}:::data
    end
    FSM --> SymbDistr

    subgraph OE ["One Epoch"]
        direction TB

        subgraph PM ["Physiology Module"]
            PM_method["Presentation Method"]:::code
            PM_source["EEG / EOG / ..."]:::code
        end

        Human("🧍 Homo Sapience")
        SI["Statistical Inference"]:::code
        APoD{{"A posteriori distribution of next symbol"}}:::data

        %% Internal flow (top to bottom)
        PM_method --> Human
        Human --> PM_source
        PM_source -->|"Distribution from Physiology"| SI
        SI --> APoD
        APoD -->|"Influence on presentation method"| PM_method
    end

    PSD["Primary Symbol Detector"]:::code

    %% Connections between blocks
    SymbDistr --> SI
    APoD --> PSD
    PSD --> PT

    PTC["Post-factum Text Correction (Slow LLM)"]:::code
    ST{{"Secondary (Corrected) Text"}}:::data
    PT --> PTC
    PTC --> ST

    RLwCT[Direct/inderect RL using corrected text]
    ST --> RLwCT
    RLwCT ---> PM_source
    RLwCT ---> PSD


    %% === Запись данных (добавлено) ===
    REC["Session Recorder"]:::new
    STOR["Storage"]:::new
    TBL["Таблица данных<br/>(заполняется)"]:::note
    REC --> STOR
    PM_method -.-> REC
    PM_source -.-> REC
    APoD -.-> REC
    PSD -.-> REC
    PT -.-> REC
    FSM -.-> REC
    PTC -.-> REC
    ST -.-> REC
    STOR ~~~ TBL

    %% === Styling ===
    classDef data fill:#d4edda,stroke:#28a745,stroke-width:2px,color:#155724
    classDef code fill:#d1ecf1,stroke:#17a2b8,stroke-width:2px,color:#0c5460
    classDef new fill:#fff3cd,stroke:#e0a800,stroke-width:2px,color:#533f03
    classDef note fill:#fff,stroke:#999,stroke-dasharray:3 3,color:#333
    style PM stroke:#6f42c1,stroke-width:3px,stroke-dasharray:8 4
